@page
@model InfoDumpManager.Web.Pages.Categories.ManageModel
@{
    ViewData["Title"] = "Manage Categories";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="idm-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Categories</li>
        </ol>
    </nav>
}

<div class="page-header">
    <h1 class="h2">Category Management</h1>
    <p class="text-muted">Create, edit, and remove categories for your GEM library.</p>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Create Category</h2>
        <form method="post" asp-page-handler="Create" class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="Create.Name" class="form-label"></label>
                <input asp-for="Create.Name" class="form-control" />
                <span asp-validation-for="Create.Name" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Create.Description" class="form-label"></label>
                <textarea asp-for="Create.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Create.Description" class="text-danger"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">Create Category</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">Existing Categories</h2>
        @if (!Model.Categories.Any())
        {
            <div class="alert alert-info" role="status">No categories created yet.</div>
        }
        else
        {
            <div class="accordion" id="categoryAccordion">
                @foreach (var category in Model.Categories)
                {
                    var collapseId = $"collapse-{category.Id}";
                    <div class="accordion-item">
                        <h3 class="accordion-header" id="heading-@category.Id">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                <span class="fw-semibold">@category.Name</span>
                                <span class="badge bg-light text-dark ms-2">@category.GemCount GEMs</span>
                            </button>
                        </h3>
                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading-@category.Id" data-bs-parent="#categoryAccordion">
                            <div class="accordion-body">
                                <div class="row g-3">
                                    <form method="post" asp-page-handler="Update" class="col-12">
                                        <input type="hidden" name="Edit.CategoryId" value="@category.Id" />
                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label class="form-label" for="edit-name-@category.Id">Name</label>
                                                <input id="edit-name-@category.Id" class="form-control" name="Edit.Name" value="@category.Name" />
                                            </div>
                                            <div class="col-12">
                                                <label class="form-label" for="edit-desc-@category.Id">Description</label>
                                                <textarea id="edit-desc-@category.Id" class="form-control" name="Edit.Description" rows="3">@category.Description</textarea>
                                            </div>
                                            <div class="col-12 d-flex gap-2 flex-wrap">
                                                <button type="submit" class="btn btn-outline-primary">Save</button>
                                            </div>
                                        </div>
                                    </form>
                                    <form method="post" asp-page-handler="Delete" class="col-12">
                                        <input type="hidden" name="DeleteCategoryId" value="@category.Id" />
                                        <button type="submit" class="btn btn-outline-danger" data-confirm="Are you sure you want to delete this category?">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
