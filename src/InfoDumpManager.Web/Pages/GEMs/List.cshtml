@page
@model InfoDumpManager.Web.Pages.GEMs.ListModel
@{
    ViewData["Title"] = "GEMs";
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="idm-breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">GEMs</li>
        </ol>
    </nav>
}

<div class="page-header d-flex flex-wrap gap-3 justify-content-between align-items-center">
    <div>
        <h1 class="h2">GEM Library</h1>
        <p class="text-muted">Browse captured snapshots and manage categorization.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Index">Submit GEM</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-6">
                <label for="categoryFilter" class="form-label">Filter by category</label>
                <select class="form-select" id="categoryFilter" name="CategoryId">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label for="pageSize" class="form-label">Items per page</label>
                <select class="form-select" id="pageSize" name="pageSize">
                    @foreach (var size in new[] { 10, 20, 50 })
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary">Apply</button>
                <a class="btn btn-outline-secondary" asp-page="/GEMs/List">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Gems.Any())
{
    <div class="alert alert-info" role="status">
        No GEMs found. Try submitting a new URL or adjusting your filters.
    </div>
}
else
{
    <div class="table-responsive shadow-sm">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">Created</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gem in Model.Gems)
                {
                    <tr data-testid="gem-row">
                        <td>
                            <div class="fw-semibold">@gem.Title</div>
                            <div class="text-muted small text-truncate">@gem.Url</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark">@(gem.CategoryName ?? "Unassigned")</span>
                        </td>
                        <td>@gem.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/GEMs/Detail" asp-route-id="@gem.Id">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="mt-4" aria-label="GEM list pagination">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" asp-page="/GEMs/List" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize" asp-route-CategoryId="@Model.CategoryId">Previous</a>
            </li>
            @{
                var start = Math.Max(1, Model.PageNumber - 2);
                var end = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                for (var i = start; i <= end; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : string.Empty)">
                        <a class="page-link" asp-page="/GEMs/List" asp-route-page="@i" asp-route-pageSize="@Model.PageSize" asp-route-CategoryId="@Model.CategoryId">@i</a>
                    </li>
                }
            }
            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : string.Empty)">
                <a class="page-link" asp-page="/GEMs/List" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize" asp-route-CategoryId="@Model.CategoryId">Next</a>
            </li>
        </ul>
    </nav>
}
