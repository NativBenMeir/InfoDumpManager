{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=infodumpmanager;Username=infodump;Password=dev_password_change_in_production"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "BucketName": "gem-snapshots",
    "UseSsl": false
  },
  "WebScraping": {
    "TimeoutSeconds": 10,
    "RetryCount": 3,
    "RetryBaseDelayMs": 250,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSeconds": 30
  },
  "JwtSettings": {
    "Issuer": "InfoDumpManager",
    "Audience": "InfoDumpManagerAPI",
    "Secret": "dev-JwtSecret-ChangeInProduction",
    "ExpiresMinutes": 60
  }
}
