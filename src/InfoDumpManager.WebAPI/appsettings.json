{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/infodumpmanager-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=infodumpmanager;Username=infodump;Password=dev_password_change_in_production"
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "BucketName": "gem-snapshots",
    "UseSsl": false
  },
  "WebScraping": {
    "TimeoutSeconds": 10,
    "RetryCount": 3,
    "RetryBaseDelayMs": 250,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerDurationSeconds": 30
  },
    "JwtSettings": {
      "Issuer": "InfoDumpManager",
      "Audience": "InfoDumpManagerAPI",
      "Secret": "dev-JwtSecret-ChangeInProduction",
      "ExpiresMinutes": 60
    },
  "AllowedHosts": "*"
}
