{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web UI",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/InfoDumpManager.Web/InfoDumpManager.Web.csproj",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        },
        {
            "name": "WebAPI",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/InfoDumpManager.WebAPI/InfoDumpManager.WebAPI.csproj",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    ],
    "compounds": [
        {
            "name": "UI + API",
            "configurations": [
                "Web UI",
                "WebAPI"
            ]
        }
    ]
}